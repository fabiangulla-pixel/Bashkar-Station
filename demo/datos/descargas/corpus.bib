@article{rev_estampa_may_1939_a0094,
  title = {a los perseguidos. La marinería se rinde, pero el capitán que forzosamente tiene que ser un tío de malas pulgas quiere impedirlo a la fuerza. Abre las llaves de los depósitos del líquido peligroso que, al mezclarse con el agua del mar, forma gases de claro, contra los cuales son impotentes las máscaras anti-gas y todos los recursos de la ciencia. El viento empuja al gas a todo lo largo del Mediterráneo. Hay un buque de pasajeros en peligro, "El Djezardín". El azar—el azar cinematográfico—quiere que en él viajen la esposa del Capitán del "Fortune", con su hijo. Pero ningún barco puede acudir al salvamento de "El Djezardín", a no ser el "Fortune". Los tres oficiales—el alemán, el inglés y el francés—inician una competencia de heroísmo y de valor: cueste lo que cueste hay que acudir en socorro del buque en peligro, para lo cual hay que atravesar las múltiples y densas cortinas que el gas ha formado en una inmensa extensión del Mediterráneo. En este preciso punto del film, llega la acción a su más dramática bancarrota. Ya el espectador no tiene prisa, ni demuestra ansiedad por las peripecias de esta pesada y lenta persecución. El desenlace de la acción, en sí, le tiene sin cuidado. Lo que ahora le preocupa es la suerte misma del autor del guión, del autor de los diálogos, del director de escena. Se subsiste una tragedia de estudio cinematográfico, mucho más interesante que la desmedrada que se corre en el lienzo de la sala de espectáculos. El escenarista, Leo Joannon, el adaptador, T. H. Robert y el autor de los diálogos, Roger Vitrac, sustituyen automáticamente a los personajes, que inútilmente gesticulan a lo largo de interminables metros de película: Ledoux, Ardisson, Daurand, Mariotti, etc., etc. Apenas si se salva la fugaz Nadine Vogel—la hija de Lucien Vogel—, director del semanario parisiense "VU". Aquella gente no sabe a dónde va. Pero en todo caso, corren hacia el fracaso con una velocidad, por nudos, mucho más espectacular y emocionante que la del propio barco de salvamento. El tierno espíritu de la Sociedad de las Naciones, trata, de señorear en la escena: todos somos hermanos; al diablo con las diferencias de raza y de pueblos, a morir todos—porque eso sí, la invitación que se hace es a morir—dentro de la mayor cordialidad internacional, con himnos "cocardiers", y con muchas dianas de clarín, muy marciales, por cierto. La película, en última instancia, se hunde, llevándose como lastre el paraguas del señor Chamberlain.},
  author = {Anónimo / Sin atribuir},
  journal = {Estampa},
  year = {1939},
  language = {spanish},
  note = {Corpus digital. Procesado con Bashkar Station.}
}

