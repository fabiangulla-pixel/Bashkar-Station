@article{rev_estampa_may_1939_a0127,
  title = {escrito por un hermano cristiano. El Amazonas sirve de escenario a las aventuras de un repórter cinematográfico y de una aviatriz, su compatriota, dispuestos en todo momento a sacrificarlo todo—hasta la misma realidad—por el puntillo de honra de sus cóngruas profesiones. Pero quien sale mal librada de este duelo profesional es la verdad, siempre tan desamparada cuando cae en manos de cineastas y de autores de guías de turismo. Así es como nos es dable ayer, en el corazón del Amazonas, instaladas de improviso las prácticas de la magia vudú, las danzas totémicas y los ritos de una religión que, sino andamos tan equivocados como los productores de la Metro, son propios de algunas tribus del Africa Central. Pero en este despilfarro del absurdo, reside precisamente la sal de este ingenioso film, en cuyos procedimientos técnicos y en cuya intención se adivina la influencia de las películas de dibujos animados. Entre las ocurrencias de Clark Gable y las de Pluto, por ejemplo, no encuentra el espectador notables diferencias y por caminos similares anda la bella Myrna Loy y sus compañeros de disparate.},
  author = {Anónimo / Sin atribuir},
  journal = {Estampa},
  year = {1939},
  language = {spanish},
  note = {Corpus digital. Procesado con Bashkar Station.}
}

