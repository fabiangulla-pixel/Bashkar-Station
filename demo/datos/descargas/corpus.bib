@article{rev_estampa_ene_1939_a0118,
  title = {una "boite de nuit" argentina; dos rusas; una austríaca; una cubana. Si Manuel Pizarro fue el introductor del tango, el cubano Castellanos fue quien impuso en París la rumba. Como las canciones pamperas argentinas, los aires cubanos, entre dulzones y frenéticos, ganaron a la capital de Francia. La "boite" de Castellanos, abierta en 1928, fue una atracción más para los forasteros. A la "Cabane Cubaine" ha acudido semanas y semanas Josefina Baker, ídolo de París; y en el interior de esta "boite" tuvo lugar uno de los más hilarantes episodios de Montmartre. Fue su protagonista el actor Buster Keaton. Acompañado por varios amigos franceses y yanquis, Buster Keaton visitó una noche, el año 32, el cabaret de Castellanos. Se destapó una botella de champagne, una segunda, una tercera. Impresionado por la forma en que una cubana había bailado la rumba, Buster Keaton se empeñó en realizar también la danza. Se anunció al público. Se encendieron de nuevo los focos, la orquesta volvió a ejecutar el mismo son y Buster Keaton, solo en la pista, bailó la rumba más desenfrenada, más arbitraria y más cómica que imaginarse pueda. A los espectadores se les saltaban las lágrimas de risa y, al terminarse aquella rumba memorable, la tributaron a Buster Keaton una ovación cerrada que duró varios minutos. Inmediatamente después, el famosísimo actor de la pantalla se empeñaba en que Castellanos había de contratarle para bailar la rumba cada noche. Y costó trabajo disuadir a Buster Keaton de su absurdo empeño.},
  author = {Anónimo / Sin atribuir},
  journal = {Estampa},
  year = {1939},
  language = {spanish},
  note = {Corpus digital. Procesado con Bashkar Station.}
}

