@article{rev_estampa_feb_1939_a0051,
  title = {pseudo revolución nacional-sindicalista que sigue predicándose desde el ministerio del Interior de Burgos aparece triunfante porque ha encontrado poderosas ayudas extranjeras y porque los militares consiguen imponerla por las armas. Para los unos como para los otros, la restauración monárquica es una regresión al punto de partida, una renunciación a los ideales desmesurados de la revolución y el imperio que les han llevado a la destrucción de la patria. Es evidente que esta renuncia a la utopía, esta vuelta a la dolorosa realidad, puede operarse más fácilmente en las masas hambrientas y abandonadas de la República que en los núcleos delirantes del nacionalismo a los que desde fuera se les inyecta el estupefaciente que les mantiene en estado de euforia. Toda solución transaccional—y la restauración monárquica no sería más que eso—puede venir del lado de la República. Del lado de Burgos no hay que esperarla mientras Burgos esté sostenido artificialmente desde el exterior.},
  author = {Anónimo / Sin atribuir},
